# =====================================================================
# SEMA ALERTA — Variáveis de ambiente (EXEMPLO, sem valores sensíveis)
# Copie para .env (ignorado pelo Git):  cp .env.example .env
# Windows (PowerShell):                 Copy-Item .env.example .env
# Status: IMPLEMENTADO (Issue #8) — lido pelo docker-compose.yml. Ver docs/DOCKER.md.
# AMBIENTE DEMONSTRATIVO — DADOS FICTÍCIOS.
# =====================================================================

# ---- Oracle Free (container) ----------------------------------------
# Senha do SYS/SYSTEM do container (obrigatória). Troque no seu .env.
ORACLE_PASSWORD=troque-esta-senha
# Usuário/schema da aplicação criado automaticamente pela imagem gvenzl/oracle-free (obrigatórios).
# A API usa este usuário/senha como SPRING_DATASOURCE_USERNAME/PASSWORD dentro do Docker.
APP_USER=SEMANEXUS
APP_USER_PASSWORD=troque-esta-senha-tambem
# A senha só vale na criação do volume `oradata`: trocá-la depois exige resetar o volume.

# ---- API (Spring Boot) ----------------------------------------------
# demo = dados fictícios + usuário de teste | dev = desenvolvimento | prod = sem seed
SPRING_PROFILES_ACTIVE=demo
# Segredo de assinatura do JWT (obrigatório, mínimo 32 caracteres). Gere um aleatório no seu .env.
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Fora do Docker (mvn spring-boot:run), configure por variáveis de ambiente do seu shell:
#   SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
#   SPRING_DATASOURCE_USERNAME=SEMANEXUS   SPRING_DATASOURCE_PASSWORD=<APP_USER_PASSWORD>
# No compose a URL padrão já é jdbc:oracle:thin:@//oracle:1521/FREEPDB1 (só defina para sobrescrever).
# SPRING_DATASOURCE_URL=
# Os arquivos enviados ficam no volume nomeado `uploads` (/data/uploads no container).

# ---- Portas no host -------------------------------------------------
# Se alguma porta já estiver em uso na sua máquina, troque aqui (ex.: API_PORT=18081).
API_PORT=8080
WEB_PORT=3000
ORACLE_PORT=1521

# ---- Visão de satélite no mapa (opcional) -----------------------------
# API Key do ArcGIS Location Platform (conta gratuita em https://location.arcgis.com),
# com permissão só de mapas base (basemaps). Vazio = opção "Satélite" desabilitada.
# NUNCA versione a chave. Uso por um órgão em produção exige a licença do próprio órgão.
ESRI_API_KEY=

# ---- SEMA DocIA (assistente) ----------------------------------------
# demo = modo demonstrativo identificado (sem IA generativa). Provider externo é opcional.
DOCIA_PROVIDER=demo
DOCIA_API_URL=
DOCIA_API_KEY=

# ---- Agentes de IA — docs/AGENTES_IA.md ---------------------------------
# ollama (padrão) = modelo aberto local, sem custo; anthropic = Claude (exige chave com créditos); demo = só regras.
AGENTES_PROVEDOR=ollama
# Sobe o serviço de IA local: ia (GPU NVIDIA) ou ia-cpu (sem GPU). Vazio = não sobe (agentes em modo demonstrativo).
COMPOSE_PROFILES=
OLLAMA_MODELO=qwen3:4b-instruct
# true só para modelos com modo de raciocínio (ex.: qwen3:4b); o padrão instruct não usa.
OLLAMA_PENSAR=false
# Tempo que o modelo fica na memória de vídeo depois do último uso (ex.: 30m, 4h; -1 = sempre). Padrão 4h.
OLLAMA_MANTER_CARREGADO=4h
# true = a API carrega o modelo em segundo plano ao iniciar (a 1ª pergunta não espera 30–50 s).
AGENTES_AQUECER=true
# Fila da GPU (#134): chamadas simultâneas ao modelo (1 = uma GPU) e espera máxima por vaga, em segundos (1–120).
# Esgotada a espera, a execução cai no modo demonstrativo identificado.
AGENTES_GPU_CONCORRENCIA=1
AGENTES_GPU_ESPERA_SEGUNDOS=20
# Busca híbrida do DocIA (#141): embeddings locais no mesmo Ollama (modelo aberto nomic-embed-text, Apache 2.0,
# 768 dimensões; baixado por scripts/ia-preparar). false ou modelo ausente = busca só lexical, sem erro.
# Padrão false: no benchmark real (docs/AGENTES_IA.md) a híbrida não superou a busca textual.
EMBEDDINGS_ATIVO=false
EMBEDDINGS_MODELO=nomic-embed-text
# Similaridade de cosseno mínima para um documento entrar só pela parte vetorial (0–1; preserva a abstenção).
EMBEDDINGS_SIMILARIDADE_MINIMA=0.65
# Intervalo (s) da verificação de documentos ainda sem trechos indexados.
EMBEDDINGS_REINDEXAR_SEGUNDOS=120
# Constante k da fusão RRF (Reciprocal Rank Fusion) entre a busca lexical e a vetorial.
BUSCA_RRF_K=60
# Streaming SSE dos agentes (#135): keepalive em segundos (1–60) e streams simultâneos (1–64; acima, 503).
AGENTES_SSE_BATIMENTO_SEGUNDOS=15
AGENTES_SSE_MAX_SIMULTANEOS=16
# Opcional (futuro): chave da Anthropic. NUNCA versione a chave.
ANTHROPIC_API_KEY=
AGENTE_TRIAGEM_MODELO=claude-haiku-5-5
AGENTE_DOCIA_MODELO=claude-sonnet-5-5

# ---- Limite de requisições (#134) — docs/API.md --------------------------
# Acima do limite na janela: 429 problem+json com Retry-After. Login conta por IP; IA e upload por usuário.
LIMITE_REQUISICOES_ATIVO=true
LIMITE_JANELA_SEGUNDOS=60
LIMITE_LOGIN_POR_JANELA=20
LIMITE_IA_POR_JANELA=10
LIMITE_UPLOAD_POR_JANELA=20
# Máximo de contadores vivos (usuário/IP por categoria); acima disso o mais antigo é descartado.
LIMITE_MAX_CHAVES=10000
# Proxies cujo X-Forwarded-For vale (IPs, CIDR ou nomes de host, separados por vírgula). Loopback sempre vale.
# No compose: web (o Nginx do Web). Vazio = só loopback (de qualquer outra origem o cabeçalho é ignorado).
LIMITE_PROXY_CONFIAVEL=web

# ---- Reset da demonstração ------------------------------------------
# Deixe vazio. Para o script demo-reset rodar sem pergunta interativa: yes
DEMO_RESET_CONFIRM=

# Diretorio dos arquivos do DocIA (no Docker, o volume uploads e montado em /data/uploads)
STORAGE_DIR=/data/uploads

# OCR opcional (Issue #140): binário e idioma do Tesseract (a imagem Docker já traz ambos).
# TESSERACT_CMD=tesseract
# TESSERACT_LANG=por
