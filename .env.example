# =====================================================================
# SEMA NEXUS — Variáveis de ambiente (EXEMPLO, sem valores sensíveis)
# Copie para .env (ignorado pelo Git):  cp .env.example .env
# Windows (PowerShell):                 Copy-Item .env.example .env
# Status: PLANEJADO — o docker-compose.yml chega pela Issue #8.
# =====================================================================

# ---- Oracle Free (container) ----------------------------------------
# Senha do SYS/SYSTEM do container. Troque no seu .env.
ORACLE_PASSWORD=troque-esta-senha
# Usuário/schema da aplicação criado automaticamente pela imagem gvenzl/oracle-free
APP_USER=SEMANEXUS
APP_USER_PASSWORD=troque-esta-senha-tambem

# ---- API (Spring Boot) ----------------------------------------------
# demo = dados fictícios + usuário de teste | dev = desenvolvimento | prod = sem seed
SPRING_PROFILES_ACTIVE=demo
# Fora do Docker, aponte para localhost:  jdbc:oracle:thin:@//localhost:1521/FREEPDB1
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//oracle:1521/FREEPDB1
SPRING_DATASOURCE_USERNAME=${APP_USER}
SPRING_DATASOURCE_PASSWORD=${APP_USER_PASSWORD}
# Segredo de assinatura do JWT (mínimo 32 caracteres). Gere um aleatório no seu .env.
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Diretório dos arquivos enviados (volume nomeado no Docker)
STORAGE_DIR=/data/uploads

# ---- Portas no host -------------------------------------------------
API_PORT=8080
WEB_PORT=3000

# ---- SEMA DocIA (assistente) ----------------------------------------
# demo = modo demonstrativo identificado (sem IA generativa). Provider externo é opcional.
DOCIA_PROVIDER=demo
DOCIA_API_URL=
DOCIA_API_KEY=

# ---- Reset da demonstração ------------------------------------------
# Deixe vazio. Para o script demo-reset rodar sem pergunta interativa: yes
DEMO_RESET_CONFIRM=
